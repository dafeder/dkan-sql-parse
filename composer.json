{
    "name": "dafeder/sql-parse-test",
    "description": "Testing parsing",
    "require": {
        "symfony/console": "^5.3",
        "greenlion/php-sql-parser": "^4.4",
        "getdkan/rooted-json-data": "^0.0.4",
        "phpmyadmin/sql-parser": "^6"
    },
    "require-dev": {
        "symfony/var-dumper": "^5.3",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "SqlParserTest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SqlParserTest\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Dan Feder",
            "email": "dan.feder@civicactions.com"
        }
    ]
